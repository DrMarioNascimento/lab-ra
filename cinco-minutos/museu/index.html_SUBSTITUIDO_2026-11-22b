<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b1721">
<title>Museu em 3D · Loop</title>
<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.1.0/model-viewer.min.js"></script>
<style>
:root{color-scheme:dark;--gold:#e7c18b;--paper:#eaf0eb}*{box-sizing:border-box}body{margin:0;background:#071019;color:var(--paper);font:16px/1.5 system-ui,sans-serif}header{display:flex;align-items:center;gap:16px;padding:14px clamp(15px,4vw,50px);background:#101c27;border-bottom:1px solid #d8b67b44}header a{color:#e7c18b;text-decoration:none;font-weight:700}header span{font-size:.8rem;color:#aab8b9}main{max-width:1500px;margin:auto;padding:20px clamp(15px,4vw,50px) 45px}h1{font:400 clamp(2rem,4vw,3.5rem)/1.05 Georgia,serif;margin:.2em 0}.eyebrow{color:#e7c18b;font-size:.72rem;letter-spacing:.16em;font-weight:700;text-transform:uppercase;margin:0}.lead{max-width:820px;color:#b7c6c4;margin:10px 0 20px}.layout{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:18px;align-items:start}.stage{position:relative;border:1px solid #d5b78155;border-radius:16px;background:radial-gradient(ellipse at 50% 35%,#3a5255,#172633 55%,#101c27);box-shadow:inset 0 1px #ffffff1f,0 15px 35px #0007;overflow:hidden;min-width:0}model-viewer{display:block;width:100%;height:min(70vh,720px);min-height:440px;--poster-color:transparent;touch-action:pan-y}.status{position:absolute;top:15px;left:16px;margin:0;padding:7px 10px;border-radius:8px;background:#08121dde;color:#e7eee8;font-size:.82rem;pointer-events:none}.controls{position:absolute;left:15px;right:15px;bottom:15px;display:flex;flex-wrap:wrap;gap:9px;pointer-events:none}.btn{border:1px solid #e4c18a88;border-radius:10px;color:#f8eddb;background:linear-gradient(#354954,#192b37);box-shadow:inset 0 1px #fff3,0 4px #071018,0 10px 20px #0007;padding:11px 15px;font:700 .9rem system-ui;text-decoration:none;cursor:pointer;pointer-events:auto}.btn:hover{filter:brightness(1.14)}.btn:active{transform:translateY(2px)}.btn.gold{background:linear-gradient(#f2d5a3,#bf8f4d);color:#191b1b}.side{border:1px solid #ad9e7666;border-radius:16px;background:#12212b;padding:20px;box-shadow:inset 0 1px #fff2,0 12px 30px #0005}.side h2{font:400 1.7rem Georgia;margin:.15em 0}.side p,.note{font-size:.87rem;color:#b3c2c0}.room-list{display:grid;gap:8px;margin-top:15px}.room{border:1px solid #d4b77d44;border-radius:9px;padding:10px;text-align:left;background:linear-gradient(#273b47,#1a2a35);color:#edf1ea;font:600 .86rem system-ui;cursor:pointer}.room:hover,.room[aria-pressed=true]{border-color:#ebc888;color:#ffe3b1}.room:focus-visible,.btn:focus-visible,a:focus-visible{outline:3px solid #f4d59b;outline-offset:3px}.floors{display:flex;gap:9px;flex-wrap:wrap;pointer-events:none}.floors .btn[aria-pressed=true]{background:linear-gradient(#f2d5a3,#bf8f4d);color:#191b1b}.room small{display:block;font-weight:400;color:#9fb2b0;font-size:.72rem}.credits{font-size:.82rem;color:#aabbb8;border-top:1px solid #c4af8255;margin-top:22px;padding-top:15px}.credits a{color:#e2c48e}.pin{pointer-events:none;transform:translate(-50%,-100%);text-align:center}.pin b{display:block;white-space:nowrap;padding:7px 12px;border-radius:10px;background:linear-gradient(#f2d5a3,#bf8f4d);color:#191b1b;font:800 .85rem system-ui;box-shadow:inset 0 1px #fff9,0 3px #6a4a1e,0 8px 16px #0008}.pin i{display:block;width:3px;height:22px;margin:0 auto;background:#f2d5a3;box-shadow:0 0 8px #f2d5a3}.floors .btn[data-k="0"][aria-pressed=true]{background:linear-gradient(#f6d58f,#d9a03d)}.floors .btn[data-k="1"][aria-pressed=true]{background:linear-gradient(#9fd0f5,#3b82c4)}.floors .btn[data-k="2"][aria-pressed=true]{background:linear-gradient(#a6e6bb,#3f9d62)}.floors .btn[data-k="0"]{border-left:5px solid #e8a940}.floors .btn[data-k="1"]{border-left:5px solid #458bd0}.floors .btn[data-k="2"]{border-left:5px solid #47b36f}@media(max-width:800px){.layout{grid-template-columns:1fr}.side{order:2}.room-list{grid-template-columns:1fr 1fr}.stage model-viewer{height:58vh;min-height:350px}.stage .controls{position:static;padding:0 15px 16px}.status{top:10px}.btn{font-size:.85rem}header span{display:none}}@media(max-width:360px){.room-list{grid-template-columns:1fr}}
</style>
</head>
<body>
<header><a href="../">← Voltar ao jogo</a><span>LAB-RA · LOOP</span></header>
<main><p class="eyebrow">Um museu para investigar</p><h1>Explore a maquete</h1><p class="lead">Conheça os três andares de um museu em miniatura. Arraste para girar, aproxime com dois dedos ou pela roda do mouse e escolha um andar e toque em uma sala para focar. A maquete é uma bancada visual e ainda não controla as pistas do jogo.</p>
<div class="layout"><section class="stage" aria-label="Visualização tridimensional do museu">
<model-viewer id="museum" src="museu-andares.glb" alt="Maquete de museu com três andares, 31 ambientes, paredes abertas, vitrines e peças de exposição" ar ar-modes="webxr scene-viewer quick-look" ar-placement="floor" ar-scale="auto" ios-src="museu-andares.usdz" camera-controls touch-action="pan-y" camera-orbit="-38deg 55deg 2.1m" min-camera-orbit="auto 15deg 0.18m" max-camera-orbit="auto 88deg 5m" field-of-view="30deg" shadow-intensity="1.1" shadow-softness="0.9" exposure="0.82" environment-image="neutral" tone-mapping="aces" interaction-prompt="none" auto-rotate auto-rotate-delay="3000" rotation-per-second="6deg">
<div slot="hotspot-pin" class="pin" data-position="0m 0m 0m" data-normal="0m 1m 0m" hidden><b id="pinNome"></b><i></i></div>
<button class="btn gold" slot="ar-button" id="enterAR">Ver na sua mesa em RA</button>
</model-viewer><p class="status" id="status" role="status">Carregando a maquete…</p>
<div class="controls"><button class="btn" type="button" id="reset">Vista geral</button><span id="floors" class="floors" role="group" aria-label="Andar"></span><a class="btn gold" id="raIphone" rel="ar" href="museu-andares.usdz" hidden>Abrir em RA no iPhone<img alt="" width="1" height="1" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="></a><a class="btn" href="museu-andares.glb" download>Baixar GLB</a><a class="btn" href="museu-andares.usdz" download>Baixar USDZ</a></div>
</section><aside class="side"><p class="eyebrow">3 andares · 31 espaços</p><h2>Ambientes</h2><p>Toque em um nome para aproximar a câmera. Cada andar repete a planta do térreo, com piso próprio, e o Pátio de luz fica vazado, do térreo ao último andar. São 31 espaços para investigar.</p><div class="room-list" id="rooms"></div><p class="note"><b>RA no celular.</b> No iPhone o botão dourado abre o arquivo nativo (Quick Look, Safari). No Android abre o Scene Viewer (Chrome com Google Play Services/ARCore). Aponte para uma mesa ou o chão, aguarde o plano aparecer e a maquete surge com cerca de 50 cm; use dois dedos para girar e mudar o tamanho. Na RA os andares aparecem juntos. Depende do aparelho, do navegador e da permissão de câmera.</p></aside></div>
<div class="credits"><strong>Origem e licença.</strong> Maquete adaptada da arquitetura de <a href="https://github.com/SamG-Coder/ThreeMuseum" target="_blank" rel="noopener">ThreeMuseum</a>, de ThreeMuseum contributors, licença MIT. Inclui sete peças originais do mesmo projeto. A adaptação remove o teto, agrupa a arquitetura por materiais, ajusta a escala para maquete, empilha a planta em três andares e acrescenta acabamentos (cores por andar, jardim, árvores e marquise) (script <code>gerar-andares.py</code>). <a href="CREDITOS.txt">Créditos e licença completos</a>. Não é um modelo de um museu real.</div>
</main>
<script>
'use strict';
const viewer=document.getElementById('museum'),status=document.getElementById('status'),list=document.getElementById('rooms');
const P=0.132;
const rooms=[
 ["Saguão superior",0,19,2],
 ["Sala dos gigantes",12.5,1,2],
 ["Sala dos predadores",29.5,1,2],
 ["Sala dos veículos",29,21,2],
 ["Sala da porcelana",-29,21,2],
 ["Sala dos jogos",-21,-17,2],
 ["Sala dos crânios",12.5,-15,2],
 ["Sala da mobília",29.5,-15,2],
 ["Galeria especial",12.5,-33,2],
 ["Auditório",29.5,-33,2],
 ["Mezanino das asas",0,19,1],
 ["Sala dos fósseis",12.5,1,1],
 ["Sala dos relógios",29.5,1,1],
 ["Sala das proteções",29,21,1],
 ["Sala da fotografia",-29,21,1],
 ["Galeria do tempo",-21,-17,1],
 ["Laboratório de formas",12.5,-15,1],
 ["Sala das coleções",29.5,-15,1],
 ["Sala dos vidros",12.5,-33,1],
 ["Sala do mar",29.5,-33,1],
 ["Recepção",0,19,0],
 ["Sala dos espécimes",12.5,1,0],
 ["Central de monitoramento",29.5,1,0],
 ["Ateliê de descobertas",29,21,0],
 ["Área de descanso",-29,21,0],
 ["Sala dos sons",-21,-17,0],
 ["Base da limpeza",12.5,-15,0],
 ["Sala do âmbar",29.5,-15,0],
 ["Pátio de luz",0,-17,0],
 ["Sala dos brinquedos",12.5,-33,0],
 ["Oficina técnica",29.5,-33,0]
];
const andarNome=['Térreo','1º andar','2º andar'];
let andar=-1;
function mostrarAndar(k){
 andar=k;
 document.querySelectorAll('#floors .btn').forEach(b=>b.setAttribute('aria-pressed',String(+b.dataset.k===k)));
 const m=viewer.model; if(!m)return;
 m.materials.forEach(mt=>{
  const n=mt.name||''; const f=n.startsWith('A1_')?1:n.startsWith('A2_')?2:0;
  const ver=(k<0)||f===k||(f<k&&false);
  const c=mt.pbrMetallicRoughness.baseColorFactor.slice();
  if(mt.__a===undefined)mt.__a=c[3];
  mt.setAlphaMode(ver&&mt.__a===1?'OPAQUE':'BLEND');
  c[3]=ver?mt.__a:0; mt.pbrMetallicRoughness.setBaseColorFactor(c);
 });
}
[['Todos',-1],['Térreo',0],['1º andar',1],['2º andar',2]].forEach(([t,k])=>{const b=document.createElement('button');b.type='button';b.className='btn';b.textContent=t;b.dataset.k=k;b.setAttribute('aria-pressed',String(k===-1));b.addEventListener('click',()=>mostrarAndar(k));document.getElementById('floors').appendChild(b)});
rooms.forEach(([name,x,z,f])=>{const b=document.createElement('button');b.type='button';b.className='room';b.innerHTML=name+'<small>'+andarNome[f]+'</small>';b.setAttribute('aria-pressed','false');b.addEventListener('click',()=>{document.querySelectorAll('.room').forEach(n=>n.setAttribute('aria-pressed','false'));b.setAttribute('aria-pressed','true');mostrarAndar(f);viewer.setAttribute('camera-target',(x/96).toFixed(4)+'m '+(f*P+0.02).toFixed(4)+'m '+(z/96).toFixed(4)+'m');viewer.setAttribute('camera-orbit','-38deg 48deg 0.55m');viewer.removeAttribute('auto-rotate');const pin=viewer.querySelector('.pin');pin.hidden=false;document.getElementById('pinNome').textContent=name;viewer.updateHotspot({name:'hotspot-pin',position:(x/96).toFixed(4)+'m '+(f*P+0.04).toFixed(4)+'m '+(z/96).toFixed(4)+'m'});});list.appendChild(b)});
if(/iPhone|iPad|iPod/.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1)){document.getElementById('raIphone').hidden=false;viewer.removeAttribute('ar');}
if(innerWidth<800){viewer.setAttribute('camera-orbit','-38deg 55deg 2.8m');}
document.getElementById('reset').addEventListener('click',()=>{viewer.querySelector('.pin').hidden=true;viewer.setAttribute('auto-rotate','');mostrarAndar(-1);document.querySelectorAll('.room').forEach(n=>n.setAttribute('aria-pressed','false'));viewer.setAttribute('camera-target','auto auto auto');viewer.setAttribute('camera-orbit','-38deg 55deg '+(innerWidth<800?'2.8':'2.1')+'m')});
viewer.addEventListener('load',()=>status.textContent='Maquete carregada · arraste para girar');
viewer.addEventListener('error',()=>status.textContent='Não foi possível carregar a maquete. Verifique a conexão e tente novamente.');
setTimeout(()=>{if(!customElements.get('model-viewer'))status.textContent='O visualizador 3D não carregou. Verifique a conexão e recarregue a página.'},12000);
</script>
</body>
</html>
