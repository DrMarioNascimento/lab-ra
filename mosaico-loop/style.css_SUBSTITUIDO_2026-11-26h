.livro-leitura p{margin:6px 0 0;font:.9375rem/1.45 system-ui,sans-serif;color:#eef2f0}
/* revisão 11: com a tábua desenhada, a leitura usa também o vão dos botões "Ler" (classe grande) e a tábua vai em 2 linhas de 6, para caber inteira sem rolar */
.livro-leitura .lc-gl.tabua{grid-template-columns:repeat(6,minmax(0,1fr));gap:3px;padding:3px;max-width:none;margin:.25rem 0 0}.livro-leitura .lc-gl.tabua .t{padding:2px 0 1px}.livro-leitura .lc-gl.tabua small{line-height:1.05}
.livro-leitura.grande{padding:6px 10px 5px}.livro-leitura.grande p{margin-top:3px;font-size:.84375rem;line-height:1.32}.livro-leitura.grande .ll-cab b{font-size:.8125rem}
.ll-cab{display:flex;align-items:center;justify-content:space-between;gap:8px}.ll-cab b{font:700 .875rem/1.2 system-ui,sans-serif;color:var(--gold)}
.ll-cab span{display:flex;gap:6px}.ll-pg{min-height:36px;padding:4px 10px;border-radius:9px;border:1px solid #9fb2bd66;background:#0b1824;color:#b9c7cc;font:700 .75rem system-ui,sans-serif;position:relative}
.ll-pg::after{content:"";position:absolute;inset:-5px}.ll-pg.on{background:var(--gold);color:#1f1b17;border-color:var(--gold)}
@media(max-width:600px){
 .board{padding-top:8px}.board .section-heading{margin:0 0 4px}
 .loop-mapa .inicio{margin-bottom:2px}
