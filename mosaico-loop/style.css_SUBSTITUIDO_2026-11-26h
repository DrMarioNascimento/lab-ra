.lc-seta{font:700 1.3rem system-ui,sans-serif;color:#d5b881;font-style:normal}
/* resultado e tela final do celular: fichas com miniatura e selo */
.lc-fins{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:10px 0 12px}
.lc-fim{display:grid;justify-items:center;align-content:start;gap:5px;min-height:132px;padding:10px 4px;border-radius:14px;text-align:center;border:1px solid #9fb2bd66;background:linear-gradient(180deg,#294051,#172633);box-shadow:inset 0 1px 0 #ffffff2b,0 4px 0 #05090d}
.lc-fim .ic3d.g{width:56px;height:56px;border-radius:14px}
.lc-fim b{font:700 .875rem/1.2 system-ui,sans-serif;color:#fff}
.lc-fim i{font:700 .75rem/1.2 system-ui,sans-serif;font-style:normal;padding:3px 8px;border-radius:99px;background:#0b161f;color:#b9c7cc}
.lc-fim.ok{border-color:#83c6ac;background:linear-gradient(180deg,#1d4039,#12261f)}.lc-fim.ok i{background:#83c6ac;color:#0c1f1a}
.lc-fim.aberto .ic3d{opacity:.7}
.lc-fim-provas{display:grid;gap:6px;margin:6px 0 2px}
.lc-fim-provas span{display:flex;align-items:center;gap:8px;min-height:44px;padding:5px 10px;border-radius:12px;font:600 .875rem/1.2 system-ui,sans-serif;border:1px solid #9fb2bd44;background:#0b1824;color:#b9c7cc}
.lc-fim-provas span.ok{border-color:#83c6ac;color:#d1fae5}.lc-fim-provas span.ok::after{content:"✓ tem";margin-left:auto;font-size:.75rem;color:#83c6ac}.lc-fim-provas span.falta::after{content:"faltou";margin-left:auto;font-size:.75rem}
/* revisão 14: fatos da noite que vieram do caderno da pessoa (mesmas miniaturas da fita do telão), fichas com volume */
.lc-fim-fatos{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:6px 0 2px;padding:0}
.lc-fim-fatos li{display:grid;justify-items:center;align-content:start;gap:5px;min-height:96px;padding:8px 4px;border-radius:14px;text-align:center;border:1px solid #83c6ac;background:linear-gradient(180deg,#1d4039,#12261f);box-shadow:inset 0 1px 0 #ffffff2b,0 4px 0 #05090d}
.lc-fim-fatos li .ic3d{width:44px;height:44px;border-radius:12px}
.lc-fim-fatos li span{font:700 .75rem/1.2 system-ui,sans-serif;color:#d1fae5;overflow-wrap:break-word;hyphens:none}
.lc-fim-fatos li.vazio{grid-column:1/-1;grid-template-columns:44px 1fr;justify-items:start;align-items:center;min-height:60px;padding:8px 12px;text-align:left;border-color:#9fb2bd66;background:linear-gradient(180deg,#294051,#172633)}
.lc-fim-fatos li.vazio span{color:#b9c7cc;font-size:.875rem}
.lc-fim-provas span.falta .ic3d{filter:grayscale(.7)}
.final-topo{display:grid;grid-template-columns:96px minmax(0,1fr);align-items:center;gap:14px;margin:8px 0 4px}
.final-topo .final-arte{width:96px;height:96px;border-radius:22px}
.final-topo h2{margin:0 0 4px}.final-topo .large{margin:0}
#finalResumo:empty{display:none}
/* manual de entrada: curto, com "Entendi" sempre à vista */
#helpDialog{padding-bottom:0}
