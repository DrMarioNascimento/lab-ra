.lc-msg{white-space:pre-line}
/* aba Atividades: cartão fechado mostra o nome e as duas salas; o texto entra ao tocar */
details.lc-ativ>summary{list-style:none;cursor:pointer;display:grid;gap:8px;min-height:44px;padding:0;margin:0;border:0;background:none;box-shadow:none;color:inherit}
details.lc-ativ>summary::before{content:none}
details.lc-ativ>summary::-webkit-details-marker{display:none}
details.lc-ativ>summary h4{margin:0}details.lc-ativ>summary h4::after{content:"▾";margin-left:auto;color:#d5b881;transition:transform .15s}
details.lc-ativ[open]>summary h4::after{transform:rotate(180deg)}
