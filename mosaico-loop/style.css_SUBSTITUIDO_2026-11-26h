/* ================================================================== Padrão visual · rodada 3 (25/11/2026)
   Profundidade em tudo que se toca, fichas de ícone com volume, cor fixa por tipo, alvos de toque de 44 px ou mais,
   caixas de tamanho fixo (nada pula) e barra inferior fixa no lugar do botão flutuante. */
/* Letra: Georgia só em título; texto corrido, rótulo e botão em system-ui. */
body,.intro,.pretitle,.large,.note,.room-panel,.prep,.inicio,.tl-texto{font-family:system-ui,-apple-system,'Segoe UI',sans-serif}
h1,h2,h3,.tour-title,.clockbox strong{font-family:Georgia,'Times New Roman',serif}
/* Ficha de ícone: miniatura 3D (ou emoji provisório) dentro de uma peça com volume. */
.ic3d{flex:none;display:inline-grid;place-items:center;width:44px;height:44px;border-radius:12px;font-size:1.4rem;line-height:1;font-style:normal;font-weight:400;color:#fff;background:radial-gradient(circle at 35% 22%,#3d6076,#16283a 72%);border:1px solid #e7b97566;box-shadow:inset 0 1px 0 #ffffff45,inset 0 -6px 10px #0006,0 3px 0 #05090d;vertical-align:middle;overflow:hidden}
.ic3d img{width:88%;height:88%;object-fit:contain;filter:drop-shadow(0 3px 2px #000b);pointer-events:none}
.ic3d.sm{width:32px;height:32px;border-radius:9px;font-size:1rem;box-shadow:inset 0 1px 0 #ffffff45,inset 0 -4px 7px #0006,0 2px 0 #05090d}
.btn .ic3d{margin-right:8px}
.btn.primary:disabled{filter:grayscale(.6);opacity:.55}
/* Fechar, links de texto e "abre e fecha": mesmo molde dos botões, 44 px ou mais. */
.close,.lc-x{flex:none;display:grid;place-items:center;width:44px;height:44px;padding:0;border-radius:50%;border:1px solid #d7bd8b77;background:linear-gradient(180deg,#294051,#172633);color:#f3ead9;font:700 1.25rem/1 system-ui,sans-serif;box-shadow:inset 0 1px 0 #ffffff2b,0 3px 0 #05090d;cursor:pointer}
.close:active,.lc-x:active{transform:translateY(2px);box-shadow:inset 0 1px 0 #ffffff15,0 1px 0 #05090d}
.lc-x{right:10px;top:10px}
.text-button{min-height:44px;padding:10px 14px;border-radius:10px;border:1px solid #d7bd8b55;background:linear-gradient(180deg,#203546,#172b3b);box-shadow:inset 0 1px 0 #ffffff22,0 3px 0 #05090d}
.text-button:active{transform:translateY(2px);box-shadow:inset 0 1px 0 #ffffff12,0 1px 0 #05090d}
.back{display:inline-block;padding:12px 0}
details>summary{list-style:none;display:flex;align-items:center;gap:8px;min-height:44px;padding:8px 12px;margin:6px 0;border-radius:10px;border:1px solid #d7bd8b44;background:linear-gradient(180deg,#203546,#172b3b);box-shadow:inset 0 1px 0 #ffffff22,0 3px 0 #05090d;color:#f2d3a0;font:700 .9rem/1.2 system-ui,sans-serif;cursor:pointer}
