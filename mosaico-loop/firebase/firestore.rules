rules_version = '2';
// Regras das salas cooperativas para o emulador local (README). No projeto mosaico-loop, as que valem estão em ../firebase-loop/firestore.rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 24;
    }
    function validAnswers(answers) {
      return answers is map && answers.keys().hasAll(['event', 'alarm', 'figure', 'action'])
        && answers.keys().hasOnly(['event', 'alarm', 'figure', 'action'])
        && answers.event in ['', 'proteger', 'troca', 'entrega', 'surpresa', 'documento', 'deslocamento', 'retorno', 'falsa']
        && answers.alarm in ['', 'sensor', 'manual', 'teste']
        && answers.figure in ['', 'guarda', 'artista', 'visitante', 'restauradora', 'funcionario']
        && answers.action in ['', 'avisar', 'confirmar', 'combinar', 'revisar', 'isolar'];
    }

    match /loopRooms/{code} {
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function liveRoom() {
        return request.time < before().createdAt + duration.value(4, 'h');
      }
      function only(fields) {
        return after().diff(before()).affectedKeys().hasOnly(fields);
      }
      function join() {
        return before().phase == 'lobby' && !(uid() in before().members)
          && only(['members']) && after().members.size() <= 6
          && after().members.diff(before().members).affectedKeys().hasOnly([uid()])
          && validName(after().members[uid()]);
      }
      function leave() {
        return before().phase == 'lobby' && before().host != uid() && uid() in before().members
          && only(['members']) && !(uid() in after().members)
          && after().members.diff(before().members).affectedKeys().hasOnly([uid()]);
      }
      function advance() {
        return before().host == uid() && only(['phase', 'loop', 'startedAt', 'answers'])
          && (
            (before().phase == 'lobby' && before().members.size() >= 2
              && after().phase == 'choose' && only(['phase']))
            || (before().phase == 'choose' && after().phase == 'playing'
              && only(['phase', 'startedAt']) && after().startedAt == request.time)
            || (before().phase == 'playing' && after().phase == 'between' && only(['phase'])
              && (before().seconds == 30 || request.time >= before().startedAt + duration.value(before().seconds, 's')))
            || (before().phase == 'between' && before().loop < 5 && after().phase == 'choose'
              && after().loop == before().loop + 1 && after().startedAt == null
              && only(['phase', 'loop', 'startedAt']))
            || (before().phase == 'between' && before().loop == 5 && after().phase == 'final'
              && only(['phase']))
            || (before().phase == 'final' && after().phase == 'result'
              && only(['phase', 'answers']) && validAnswers(after().answers))
          );
      }
      allow get: if signedIn() && code.matches('^[A-Z2-9]{12}$')
        && (resource == null || (liveRoom() && (before().phase == 'lobby' || uid() in before().members)));
      allow create: if signedIn() && code.matches('^[A-Z2-9]{12}$')
        && after().keys().hasOnly(['host', 'members', 'phase', 'loop', 'caseIndex', 'createdAt', 'startedAt', 'seconds', 'answers'])
        && after().host == uid() && after().phase == 'lobby' && after().loop == 1
        && after().members is map && after().members.keys().hasOnly([uid()]) && validName(after().members[uid()])
        && after().caseIndex is int && after().caseIndex >= 0 && after().caseIndex < 15
        && after().createdAt == request.time && after().startedAt == null && after().answers == null
        && after().seconds in [30, 300];
      allow update: if signedIn() && liveRoom() && (join() || leave() || advance());
    }

    match /loopClocks/{userId} {
      allow get: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['time'])
        && request.resource.data.time == request.time;
    }
  }
}
